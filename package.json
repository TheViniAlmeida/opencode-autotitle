{
  "name": "opencode-autotitle",
  "version": "0.1.3",
  "description": "AI-powered automatic session naming for OpenCode - titles your sessions based on context",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:coverage": "vitest run src --coverage",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheViniAlmeida/opencode-autotitle.git"
  },
  "bugs": {
    "url": "https://github.com/TheViniAlmeida/opencode-autotitle/issues"
  },
  "homepage": "https://github.com/TheViniAlmeida/opencode-autotitle#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "session",
    "title",
    "auto-title",
    "autotitle",
    "naming",
    "ai",
    "automatic",
    "smart-title",
    "session-name",
    "session-management",
    "productivity",
    "developer-tools",
    "cli",
    "terminal"
  ],
  "author": "Pawel Madejski",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "server.js",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./server": "./server.js"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.22"
  },
  "overrides": {
    "picomatch@>=4.0.0 <4.0.4": "4.0.4"
  }
}
